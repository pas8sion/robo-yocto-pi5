# short-description: Raspberry Pi image for USB boot
# long-description: Based on meta-raspberrypi sdimage-raspberrypi.wks,
# but partitions are referenced as /dev/sdaN so /etc/fstab matches
# a USB storage device instead of microSD.

part /boot --source bootimg-partition --ondisk sda --fstype=vfat --label boot --active --align 4096 --size 100
part / --source rootfs --ondisk sda --fstype=ext4 --label root --align 4096
